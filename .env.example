# AquaPulse v8 — Environment Variables
# Copy to .env and fill in real values

# ─── Database ──────────────────────────────────────────────────────────────────
# Neon Serverless Postgres — get free at https://neon.tech
NEON_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/aquapulse?sslmode=require

# ─── Redis ─────────────────────────────────────────────────────────────────────
# Upstash Cloud Redis — get free at https://upstash.com
REDIS_URL=rediss://default:TOKEN@us1-xxx.upstash.io:6379

# ─── LLM Keys (cascade: Groq → Cerebras → Gemini → OpenRouter) ────────────────
# Groq — free at https://console.groq.com (primary, Llama 3.3 70B)
GROQ_API_KEY=gsk_xxx

# Cerebras — free at https://cloud.cerebras.ai (fallback)
CEREBRAS_API_KEY=

# Gemini — free at https://aistudio.google.com (fallback)
GEMINI_API_KEY=

# OpenRouter — free tier at https://openrouter.ai (final fallback)
OPENROUTER_API_KEY=

# ─── Service URLs (for Gateway routing; override in prod) ─────────────────────
VERIFY_SERVICE_URL=http://localhost:8081
ALLOCATION_SERVICE_URL=http://localhost:8082
GUARANTEE_SERVICE_URL=http://localhost:8083
COPILOT_SERVICE_URL=http://localhost:8084

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=https://your-gateway.onrender.com
